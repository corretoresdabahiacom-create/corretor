{
  // Worker único: serve a API, as páginas públicas (/p, /v) e o app web (arquivos estáticos). Plano gratuito, sem cartão.
  "name": "corretor",
  "main": "server/src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // As migrações .sql entram no bundle como texto; o Worker aplica as pendentes sozinho (AUTO_MIGRATE=false desliga).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*", "/v/*", "/d/*", "/ical/*", "/robots.txt", "/sitemap.xml"]
  },
  "alias": {
    "sharp": "./server/src/worker-stubs/missing.ts",
    "argon2": "./server/src/worker-stubs/missing.ts",
    "@aws-sdk/client-s3": "./server/src/worker-stubs/missing.ts"
  },
  "vars": {
    "NODE_ENV": "production",
    "STORAGE_DRIVER": "db",
    "COOKIE_SECURE": "true",
    "TRUST_PROXY": "true",
    "APP_NAME": "ImobFlow"
  },
  "observability": { "enabled": true }
}
