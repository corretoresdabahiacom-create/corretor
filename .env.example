# Copie para .env. NUNCA versione o .env real.
DATABASE_URL=postgres://imobflow:troque_esta_senha@127.0.0.1:5432/imobflow
# Neon (produção): copie a connection string do console (Connect). Exige SSL.
# DATABASE_URL=postgres://USUARIO:SENHA@ep-xxxx.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Testes (npm test): banco SEPARADO cujo nome contém "test" (ex.: branch "test", banco imobflow_test).
# O setup APAGA o schema public desse banco. Nunca aponte para o banco de produção.
# TEST_DATABASE_URL=postgres://USUARIO:SENHA@ep-yyyy.c-2.sa-east-1.aws.neon.tech/imobflow_test?sslmode=require
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false          # true em produção (HTTPS)
SESSION_DAYS=14
NODE_ENV=development
# Só em desenvolvimento: devolve links de convite/recuperação na resposta (e-mail não integrado).
DEV_EXPOSE_TOKENS=true

# Arquivos: 'local' (dev, pasta STORAGE_DIR), 'db' (no próprio Postgres: grátis e persistente) ou 's3' (compatível com S3, ex.: Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_DIR=./storage-dev
MAX_UPLOAD_MB=10
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_BUCKET=imobflow-arquivos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Portal público
FORM_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Opcional (Cloudflare Turnstile, gratuito):
# TURNSTILE_SECRET=
# TURNSTILE_SITE_KEY=

# Produção (a API recusa subir com configuração insegura)
# NODE_ENV=production
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://seu-dominio.com.br
# TRUST_PROXY=true           # atrás de Cloudflare/Tunnel
# WEB_DIST=../web/dist       # a própria API serve o app
# DEV_EXPOSE_TOKENS=false
# E-mail transacional (Resend tem plano gratuito):
# EMAIL_DRIVER=resend        # none | console | resend
# EMAIL_FROM="ImobFlow <nao-responda@seu-dominio.com.br>"
# RESEND_API_KEY=

# Vídeos enviados (MP4/WebM)
MAX_VIDEO_MB=30
MAX_ORG_VIDEO_MB=150
